# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Encrypts tenant Autotask/Halo credentials at rest (AES-256-GCM).
# Generate with: npm run keygen
# Losing this makes every stored connection unreadable.
# ---------------------------------------------------------------------------
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Shared secret for /api/worker. Vercel Cron sends this as a bearer token.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Stripe (optional — leave blank to run admin-granted credits only)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Public URL of this deployment. Inferred on Vercel; set for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
